    "client": "node dist/client.js"
  },
  "dependencies": {
    "@renderinc/sdk": "1.11.0",
    "blurhash": "2.0.5",
    "openai": "7.65.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
