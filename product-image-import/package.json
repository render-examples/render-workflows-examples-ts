{
  "name": "product-image-import-workflow",
  "version": "1.0.0",
  "description": "Product image import - resized WebP/AVIF variants, blurhash and AI alt text per image (TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
